{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.internal/contracts/agent-run-project-codex-v1.result.schema.json",
  "title": "Atenea exact project Codex result",
  "type": "object",
  "additionalProperties": false,
  "required": ["threadId", "turnId", "finalAnswer", "outputSummary"],
  "properties": {
    "threadId": {"type": "string", "format": "uuid"},
    "turnId": {"type": "string", "format": "uuid"},
    "finalAnswer": {"type": "string", "minLength": 1, "maxLength": 262144},
    "outputSummary": {"const": "project-codex-v1 completed"}
  }
}
