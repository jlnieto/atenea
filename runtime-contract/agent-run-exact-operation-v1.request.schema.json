{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.internal/contracts/agent-run-exact-operation-v1.request.schema.json",
  "title": "Atenea exact owned AgentRun operation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["executionId", "sessionId", "workspaceIdentity", "leaseGeneration"],
  "properties": {
    "executionId": {"type": "string", "format": "uuid"},
    "sessionId": {"type": "string", "format": "uuid"},
    "workspaceIdentity": {
      "type": "string",
      "pattern": "^remote:ax42-01:work-session:[0-9a-f-]{36}$"
    },
    "leaseGeneration": {"type": "integer", "minimum": 1}
  }
}
