{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.codynwave.com/schemas/dev-envelope-v1.schema.json",
  "title": "Atenea dev JSON envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "state",
    "timestamp"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "sessionId": {"type": "string", "format": "uuid"},
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "operation": {
      "enum": [
        "list",
        "status",
        "build",
        "up",
        "stop",
        "restart",
        "redeploy",
        "logs",
        "url",
        "doctor"
      ]
    },
    "state": {
      "enum": [
        "pending",
        "running",
        "ready",
        "stopped",
        "blocked",
        "error",
        "reconciling"
      ]
    },
    "allocation": {
      "$ref": "session-allocation-v1.schema.json"
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["unknown", "starting", "healthy", "unhealthy", "stopped"]
        },
        "summary": {"type": "string", "maxLength": 200}
      }
    },
    "url": {
      "type": "string",
      "pattern": "^(https://[A-Za-z0-9.-]+|http://127\\.0\\.0\\.1:[0-9]{4,5})(/.*)?$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "action"],
      "properties": {
        "code": {
          "enum": [
            "SESSION_REQUIRED",
            "SESSION_AMBIGUOUS",
            "SESSION_IDENTITY_CONFLICT",
            "WORKTREE_CONFLICT",
            "WORKTREE_DIRTY",
            "RUNTIME_OWNERSHIP_CONFLICT",
            "NORMAL_CAPACITY_EXHAUSTED",
            "HEAVY_CAPACITY_EXHAUSTED",
            "MANIFEST_INVALID",
            "TOOLCHAIN_UNAVAILABLE",
            "HEALTH_CHECK_FAILED",
            "OPERATION_FAILED",
            "RECONCILIATION_REQUIRED"
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 200},
        "retryable": {"type": "boolean"},
        "action": {"type": "string", "minLength": 1, "maxLength": 240},
        "details": {
          "type": "object",
          "maxProperties": 12,
          "additionalProperties": {
            "type": ["string", "integer", "boolean", "null"]
          }
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {"enum": ["blocked", "error"]}
        },
        "required": ["state"]
      },
      "then": {"required": ["error"]},
      "else": {"not": {"required": ["error"]}}
    },
    {
      "if": {
        "properties": {
          "operation": {"enum": ["build", "up", "stop", "restart", "redeploy", "logs", "url"]}
        },
        "required": ["operation"]
      },
      "then": {"required": ["sessionId", "projectId"]}
    }
  ]
}
