{
  "schemaVersion": 1,
  "project": {
    "id": "dummy-tomcat",
    "repository": {
      "url": "https://github.com/example/dummy-tomcat.git",
      "defaultBranch": "main"
    }
  },
  "toolchains": [
    {"name": "java-build", "version": "17.0.19", "source": "container-image"},
    {"name": "java-runtime", "version": "8.0.402", "source": "container-image"},
    {"name": "docker", "version": "29.6.2", "source": "worker-package"}
  ],
  "runtime": {
    "kind": "tomcat",
    "webappModule": "src",
    "warPath": "target/fixture.war",
    "contextPath": "/",
    "internalPorts": [
      {"name": "web", "port": 8080, "protocol": "http"}
    ]
  },
  "lifecycle": {
    "build": {"argv": ["MANIFEST_ARGV_MUST_NOT_RUN", "build"], "timeoutSeconds": 600},
    "start": {"argv": ["MANIFEST_ARGV_MUST_NOT_RUN", "up"], "timeoutSeconds": 120},
    "stop": {"argv": ["MANIFEST_ARGV_MUST_NOT_RUN", "stop"], "timeoutSeconds": 120},
    "health": {"argv": ["MANIFEST_ARGV_MUST_NOT_RUN", "health"], "timeoutSeconds": 30},
    "logs": {"argv": ["MANIFEST_ARGV_MUST_NOT_RUN", "logs"], "timeoutSeconds": 30}
  },
  "preview": {
    "internalPort": "web",
    "path": "/",
    "publish": "private",
    "command": {"argv": ["MANIFEST_ARGV_MUST_NOT_RUN", "preview"], "timeoutSeconds": 30},
    "localhostCompatibilityRequired": true
  },
  "browserChecks": [
    {
      "name": "health",
      "path": "/",
      "command": {"argv": ["MANIFEST_ARGV_MUST_NOT_RUN", "browser"], "timeoutSeconds": 30},
      "viewports": ["desktop-1440x900"],
      "artifact": "artifacts/browser/health"
    }
  ],
  "artifacts": [
    {"name": "war", "path": "target/fixture.war", "retention": "run"}
  ],
  "secrets": [],
  "workloadClass": "normal"
}
