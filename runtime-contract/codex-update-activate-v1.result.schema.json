{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.internal/contracts/codex-update-activate-v1.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "workerId", "planId", "candidateId",
    "authorizationId", "idempotencyKey", "state", "codexVersion",
    "releaseDigestSha256", "catalogRevision", "schemaComparison",
    "focusedContracts", "workerHealth", "canary", "currentBeforeFingerprint",
    "previousBeforeFingerprint", "currentAfterFingerprint",
    "previousAfterFingerprint", "automaticRestore", "valuesExposed"
  ],
  "properties": {
    "schemaVersion": {"const": "codex-update-activate-v1"},
    "operation": {"const": "ACTIVATE_CODEX_UPDATE"},
    "workerId": {"const": "ax42-01"},
    "planId": {"type": "string", "format": "uuid"},
    "candidateId": {"type": "string", "format": "uuid"},
    "authorizationId": {"type": "string", "format": "uuid"},
    "idempotencyKey": {"type": "string", "format": "uuid"},
    "state": {"const": "ACTIVATED"},
    "codexVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "releaseDigestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalogRevision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schemaComparison": {"const": "PASS"},
    "focusedContracts": {"const": "PASS"},
    "workerHealth": {"const": "PASS"},
    "canary": {"const": "PASS"},
    "currentBeforeFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previousBeforeFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "currentAfterFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previousAfterFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "automaticRestore": {"enum": ["NOT_REQUIRED", "PASS"]},
    "valuesExposed": {"const": false}
  }
}
