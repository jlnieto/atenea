{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.internal/contracts/agent-run-project-codex-v1.request.schema.json",
  "title": "Atenea exact project Codex dispatch request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dispatchId",
    "sessionId",
    "workspaceIdentity",
    "workloadClass",
    "leaseGeneration",
    "workload"
  ],
  "properties": {
    "dispatchId": {"type": "string", "format": "uuid"},
    "sessionId": {"type": "string", "format": "uuid"},
    "workspaceIdentity": {
      "type": "string",
      "pattern": "^remote:ax42-01:work-session:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workloadClass": {"enum": ["NORMAL", "HEAVY"]},
    "leaseGeneration": {"type": "integer", "minimum": 1},
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "projectId",
        "repository",
        "branch",
        "commit",
        "manifestSha256",
        "instructionBundleRevision",
        "instructionBundleSha256",
        "platformInstructionSha256",
        "projectInstructionPath",
        "projectInstructionSha256",
        "message",
        "threadId"
      ],
      "properties": {
        "kind": {"const": "project-codex-v1"},
        "projectId": {"const": "atenea"},
        "repository": {"const": "https://github.com/jlnieto/atenea.git"},
        "branch": {"const": "main"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifestSha256": {"const": "327a0c521017109d7c0067a11e7d8c3ad2079de4ea78d28296848f9de39c164b"},
        "instructionBundleRevision": {"const": "atenea-reviewed-instruction-bundle-v1"},
        "instructionBundleSha256": {"const": "ab9f1877c83333945497797e6b8aefd20f67debf8e3bdc6d1b824fc5a3f86c04"},
        "platformInstructionSha256": {"const": "44c578a286eb50b35612be0b6c38d59a503e6fee1ecf6cd0339415af018cdf0d"},
        "projectInstructionPath": {"const": "AGENTS.md"},
        "projectInstructionSha256": {"const": "a09adc5855ff54490211a0f5c82f413cb84ee7197b2b350e0b0dc40eba7c98dc"},
        "message": {"type": "string", "minLength": 1, "maxLength": 20000},
        "threadId": {"type": ["string", "null"], "format": "uuid"}
      }
    }
  }
}
