{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.internal/contracts/agent-run-progress-v1.schema.json",
  "title": "Atenea sanitized AgentRun progress event",
  "type": "object",
  "additionalProperties": false,
  "required": ["dispatchId", "executionId", "sequence", "category", "occurredAt", "message"],
  "properties": {
    "dispatchId": {"type": "string", "format": "uuid"},
    "executionId": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 1},
    "category": {
      "enum": [
        "ACCEPTED",
        "QUEUED",
        "PREPARING_WORKSPACE",
        "CODEX_STARTED",
        "INSPECTING_PROJECT",
        "RUNNING_COMMAND",
        "CHECKING",
        "WAITING",
        "RECONCILING",
        "FINALIZING",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "occurredAt": {"type": "string", "format": "date-time"},
    "message": {"type": "string", "minLength": 1, "maxLength": 160}
  }
}
