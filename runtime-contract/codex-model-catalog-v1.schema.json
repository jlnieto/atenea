{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.internal/contracts/codex-model-catalog-v1.schema.json",
  "title": "Atenea worker Codex model catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogRevision",
    "workerId",
    "codexVersion",
    "generatedAt",
    "models"
  ],
  "properties": {
    "schemaVersion": {"const": "codex-model-catalog-v1"},
    "catalogRevision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workerId": {"const": "ax42-01"},
    "codexVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelId",
          "displayName",
          "supportedEfforts",
          "defaultEffort",
          "availability"
        ],
        "properties": {
          "modelId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
          },
          "displayName": {"type": "string", "minLength": 1, "maxLength": 80},
          "supportedEfforts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["none", "low", "medium", "high", "xhigh", "max"]}
          },
          "defaultEffort": {"enum": ["none", "low", "medium", "high", "xhigh", "max"]},
          "availability": {"enum": ["AVAILABLE", "DEPRECATED", "BLOCKED"]}
        }
      }
    }
  }
}
