[Unit]
Description=Atenea worker host health verification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/atenea-worker-verify --json --strict
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/proc/mdstat /sys /etc /srv/atenea

[Install]
WantedBy=multi-user.target
