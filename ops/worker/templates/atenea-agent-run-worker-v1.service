[Unit]
Description=Atenea private AgentRun worker v1
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=atenea-worker
Group=atenea
ExecStart=/usr/local/libexec/atenea/agent-run-worker-v1.py --bind ${ATENEA_WORKER_BIND} --port ${ATENEA_WORKER_PORT} --worker-id ${ATENEA_WORKER_ID} --state-dir /srv/atenea/worker/agent-runs-v1 --token-file /etc/atenea-worker/agent-run-worker-v1.token --normal-capacity 4 --heavy-capacity 2 --project-config /etc/atenea-worker/project-codex-v1.json --project-runner /usr/local/libexec/atenea/project-codex-runner-v1.py --project-timeout 1800
EnvironmentFile=/etc/atenea-worker/agent-run-worker-v1.env
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=15s
NoNewPrivileges=false
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=false
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/srv/atenea/worker/agent-runs-v1 /srv/atenea/workspaces/sessions /home/jose/.codex
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
