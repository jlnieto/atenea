  "failClosedRules": [
    "Reject before connection when a database host, name or user does not match this contract and the admitted session.",
    "Reject before read or copy when any source is a dump, existing volume, row export, backup or snapshot.",
    "Reject before startup when a forbidden secret reference is present or a literal secret is supplied.",
    "Reject before network access when an external integration is enabled or resolves outside the session-owned network and loopback.",
    "Reject before fixture mutation when existing rows differ from the declared identity, counts or fixed fields.",
    "Reject every managed-host, deployment, backup, restore, production-operation or undeclared-fixture request."
  ]
