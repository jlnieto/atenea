    {
      "name": "flyway-chain",
      "query": "SELECT count(*) AS applied_count, min(installed_rank) AS first_rank, max(installed_rank) AS last_rank, count(*) FILTER (WHERE NOT success) AS failed_count FROM flyway_schema_history;",
